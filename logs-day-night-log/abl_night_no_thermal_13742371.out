------------------------------------------------------------
# LSBATCH: User input
#!/bin/bash
# ============================================
# LSF — Day/Night Ablation: NoThermal (night)
# 128x128 + inner_ch=32 + pure L2 + GPU
# ============================================
#BSUB -q 723090ib
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "rusage[mem=32000]"
#BSUB -J abl_night_no_thermal
#BSUB -o logs/abl_night_no_thermal_%J.out
#BSUB -e logs/abl_night_no_thermal_%J.err

module load anaconda/3
module load cuda/11.8.0
source activate wind3d

cd $LS_SUBCWD
mkdir -p logs

echo "=== Ablation: NoThermal | Filter: night ==="
echo "Config: configs/config_wind_3d_ablation_no_thermal_night.yml"
echo "Host: $(hostname)"
echo "GPU:  $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'N/A')"
echo "Start: $(date)"
echo ""

python scripts/train_schrodinger_bridge_model.py \
  --config_path configs/config_wind_3d_ablation_no_thermal_night.yml \
  --experiment_name ExperimentSchrodingerBridge3dWind \
  --device cuda:0

echo ""
echo "End: $(date)"

