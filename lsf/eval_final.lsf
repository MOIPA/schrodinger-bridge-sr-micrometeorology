#!/bin/bash
# ============================================
# LSF 评估脚本 — Final 模型
# ============================================
#BSUB -q 723090ib
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "rusage[mem=32000]"
#BSUB -J final_eval
#BSUB -o logs/final_eval_%J.out
#BSUB -e logs/final_eval_%J.err

# --- 环境 ---
module load anaconda/3
module load cuda/11.8.0
source activate wind3d

cd $LS_SUBCWD
mkdir -p logs

BASE="data/DL_result/ExperimentSchrodingerBridge3dWind"
EXP="ExperimentSchrodingerBridge3dWind"

echo "=== Evaluating Final Model ==="
echo "Start: $(date)"

python scripts/evaluate_wind_3d.py \
  --config_path configs/香港-基础/config_wind_3d_final.yml \
  --checkpoint_path ${BASE}/config_wind_3d_final/checkpoint.pth \
  --experiment_name ${EXP} \
  --device cuda:0 \
  --split test \
  --output_dir results/eval_final

echo ""
echo ">>> Generating figures..."
python scripts/plot_experiment_results.py --results_dir results/

echo ""
echo "End: $(date)"
